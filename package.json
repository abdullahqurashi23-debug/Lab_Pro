{
  "name": "labcore",
  "version": "1.0.3",
  "description": "LabCore — offline laboratory report management system",
  "author": "LabCore",
  "main": "dist-electron/electron/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/prepare-electron.js",
    "dev": "concurrently -k -n vite,tsc,electron -c blue,yellow,green \"npm:dev:vite\" \"npm:dev:electron-build\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron-build": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main/index.js && cross-env NODE_ENV=development electron .",
    "prebuild": "node scripts/prepare-electron.js",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "generate-icon": "node scripts/generate-icon.mjs",
    "seed": "tsx src/db/seed.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --publish never",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@fontsource/inter": "^5.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fuse.js": "^7.0.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.451.0",
    "playwright-core": "^1.47.2",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.labpro.app",
    "productName": "LabCore",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
